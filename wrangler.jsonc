// Publicación en Cloudflare (Workers con "static assets"), igual que la tienda.
// "name" TIENE que coincidir con el nombre del Worker en el panel de Cloudflare.
{
  "name": "reservas-mes-malgrat",
  "compatibility_date": "2026-10-15",
  "build": { "command": "npm run build" },
  "preview_urls": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
